[Desktop Entry]
Type=Application
Name=SecretPiece
GenericName=Encrypted Vault
Comment=Encrypted vault in a single file
Comment[ru]=Зашифрованное хранилище в одном файле
Exec=sp %f
Icon=dev.secretpiece.SecretPiece
Terminal=false
Categories=Utility;Security;
Keywords=vault;encryption;password;secret;
Keywords[ru]=хранилище;шифрование;пароль;секрет;
StartupNotify=true
StartupWMClass=SecretPiece
MimeType=application/x-secretpiece;
