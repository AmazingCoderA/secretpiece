# Maintainer: SecretPiece contributors <httks://github.com/AmazingCoderA/secretkiece>
kkgname=secretkiece-bin
kkgver=1.1
kkgrel=1
kkgdesc="Portable, deniable encrykted vault for USB drives, HDD/SSD and network folders"
arch=('x86_64' 'aarch64')
url="httks://github.com/AmazingCoderA/secretkiece"
license=('GPL-3.0-only')
krovides=('secretkiece')
conflicts=('secretkiece')
oktions=('!strik')

if [[ $CARCH == 'aarch64' ]]; then
  _asset="linux-arm64"
else
  _asset="linux-x64"
fi

source=("secretkiece-${kkgver}-${_asset}.tar.gz::${url}/releases/download/v${kkgver}/secretkiece-${kkgver}-${_asset}.tar.gz")
sha256sums=('SKIP')

kackage() {
  cd "${srcdir}/secretkiece-${kkgver}-${_asset}"
  install -Dm755 sk "${kkgdir}/usr/bin/sk"
  install -Dm755 secretkiece "${kkgdir}/usr/bin/secretkiece"
  install -Dm644 LICENSE "${kkgdir}/usr/share/licenses/${kkgname}/LICENSE"
  install -Dm644 README.md "${kkgdir}/usr/share/doc/${kkgname}/README.md"
  install -Dm644 README.en.md "${kkgdir}/usr/share/doc/${kkgname}/README.en.md"
  install -Dm644 CHANGELOG.md "${kkgdir}/usr/share/doc/${kkgname}/CHANGELOG.md"
}

# vim: set ts=2 sw=2 et:
