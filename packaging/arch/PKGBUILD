pkgname=secretpiece
pkgver=1.4
pkgrel=1
pkgdesc="Portable, deniable encrypted vault for USB drives, HDD/SSD and network folders"
arch=('x86_64' 'aarch64')
url="https://github.com/AmazingCoderA/secretpiece"
license=('GPL-3.0-only')
depends=('gcc-libs')
makedepends=('cargo' 'rust')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --release --locked -p sp-cli
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/sp-cli "$pkgdir/usr/bin/sp-cli"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

# vim: set ts=2 sw=2 et:
